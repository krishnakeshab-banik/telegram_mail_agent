# Telegram. Create the bot with @BotFather. Only these numeric user ids are answered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Gemini. Comma-separated names, tried in order on 429, 503, or 404.
GEMINI_API_KEY=
GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest

# Google OAuth client. Type must be Web application. See SETUP.md.
# Authorized redirect URI: {PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used only by scripts/authorize_google.py. The Telegram connect link does not read this.
GOOGLE_REDIRECT_URI=http://localhost:8080/

# Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# sqlite+aiosqlite or a Postgres URL such as postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./data/executive_agent.db

# live talks to Google. demo reads tests/fixtures and writes data/demo_outbox.jsonl.
APP_MODE=live
POLL_INTERVAL_MINUTES=2
TIMEZONE=Asia/Kolkata
BRIEFING_HOUR=8
BRIEFING_MINUTE=0
WRAPUP_HOUR=20
WRAPUP_MINUTE=0
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
IMPORTANCE_NOTIFY_THRESHOLD=60
APPROVAL_TTL_MINUTES=60
MAX_ATTACHMENT_BYTES=10000000
APPLY_GMAIL_LABELS=false
HEALTH_PORT=8081
# Log console. Off by default. When true, only loopback can open it.
CONSOLE_ENABLED=false
FOLLOWUP_NUDGE_HOURS=48
REMINDER_LEAD_MINUTES=1440,120
LOG_LEVEL=INFO
LOG_JSON=true
FIXTURE_DIR=tests/fixtures

# Signup. open lets anyone join. invite requires INVITE_CODE. closed rejects new accounts.
SIGNUP_MODE=open
INVITE_CODE=
MAX_USERS=100
ADMIN_TELEGRAM_IDS=
SIGNUP_THROTTLE_SECONDS=30

# Public HTTPS origin for the Google web callback, with no path.
# Example: https://agent.example.com
PUBLIC_BASE_URL=
BODY_RETENTION_DAYS=30
